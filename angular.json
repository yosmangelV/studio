{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "design-system": {
      "projectType": "library",
      "root": "projects/design-system",
      "sourceRoot": "projects/design-system/src",
      "prefix": "ds",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/design-system/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/design-system/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/design-system/tsconfig.spec.json",
            "setupFiles": [
              "projects/design-system/src/test-setup.ts"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "design-system:build",
            "tsConfig": "tsconfig.storybook.json",
            "styles": [
              "projects/design-system/src/styles/global.css",
              "projects/design-system/src/styles/tokens.scss"
            ],
            "compodoc": false,
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "design-system:build",
            "tsConfig": "tsconfig.storybook.json",
            "styles": [
              "projects/design-system/src/styles/global.css",
              "projects/design-system/src/styles/tokens.scss"
            ],
            "compodoc": false,
            "outputDir": "dist/storybook"
          }
        }
      }
    },
    "announcement-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/announcement-web",
      "sourceRoot": "projects/announcement-web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/announcement-web/src/main.ts",
            "tsConfig": "projects/announcement-web/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/announcement-web/public"
              }
            ],
            "styles": [
              "projects/announcement-web/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/announcement-web/src/environments/environment.ts",
                  "with": "projects/announcement-web/src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "announcement-web:build:production"
            },
            "development": {
              "buildTarget": "announcement-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "boxing-gym": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/boxing-gym",
      "sourceRoot": "projects/boxing-gym/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/boxing-gym/src/main.ts",
            "tsConfig": "projects/boxing-gym/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/boxing-gym/public"
              }
            ],
            "styles": [
              "projects/design-system/src/styles/global.css",
              "projects/boxing-gym/src/styles.scss"
            ],
            "localize": false,
            "polyfills": [
              "@angular/localize/init"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "production-es": {
              "localize": [
                "es"
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "production-en": {
              "localize": [
                "en"
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development-es": {
              "localize": [
                "es"
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "development-en": {
              "localize": [
                "en"
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "boxing-gym:build:production"
            },
            "development": {
              "buildTarget": "boxing-gym:build:development"
            },
            "development-es": {
              "buildTarget": "boxing-gym:build:development-es"
            },
            "development-en": {
              "buildTarget": "boxing-gym:build:development-en"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/boxing-gym/tsconfig.spec.json",
            "setupFiles": [
              "projects/boxing-gym/src/test-setup.ts"
            ]
          }
        }
      },
      "i18n": {
        "sourceLocale": "es",
        "locales": {
          "en": {
            "translation": "projects/boxing-gym/src/locale/messages.en.xlf"
          }
        }
      }
    }
  }
}
